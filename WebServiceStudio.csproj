<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <StartupObject>WebServiceStudio.MainForm</StartupObject>
    <RootNamespace>WebServiceStudio</RootNamespace>
    <AssemblyName>WebServiceStudio</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>WebServiceStudio.WebServiceStudio.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="WebServiceStudio.WebServiceStudio.ico"
                      LogicalName="WebServiceStudio.WebServiceStudio.ico" />
  </ItemGroup>
</Project>
